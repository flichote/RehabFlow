# RehabFlow 生产环境变量（复制为 .env 使用）
# 部署文档：docs/ops/deployment.md

# ── 必改 ──
# JWT 签名密钥：openssl rand -hex 32 生成
SECRET_KEY=change-me-in-production

# ── 可选 ──
# 对外 HTTP 端口（默认 80）
WEB_PORT=80

# 启用 PostgreSQL 时的数据库密码（默认注释状态）
# PG_PASSWORD=rehabflow

# ⚠️ HIS 隔离纪律：禁止添加 HIS_API_URL 等任何 HIS 相关配置（见 docs/architecture.md §9）
