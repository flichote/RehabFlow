# RehabFlow backend environment variables
# Copy to .env and customize

# Database connection (single switch: SQLite dev / PG16 prod)
# Dev/demo: SQLite (zero-dependency)
DATABASE_URL=sqlite+aiosqlite:///./rehabflow.db
# Production (PostgreSQL 16):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/rehabflow

# JWT secrets (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=RehabFlow
